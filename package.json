{
  "name": "field-trip-agent",
  "version": "0.0.0",
  "private": true,
  "description": "Build It Workshop: a durable AI agent with the Flue Framework on Cloudflare Workers",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "vite dev --strictPort",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "check": "node scripts/check.mjs",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@flue/runtime": "2.1.1",
    "hono": "4.13.10",
    "just-bash": "3.4.2",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.0",
    "@flue/cli": "2.1.1",
    "@flue/vite": "2.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "wrangler": "4.143.0"
  }
}
